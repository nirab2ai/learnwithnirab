rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images are publicly readable for e-commerce catalog
    match /products/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'nirab2ai@gmail.com' && request.auth.token.email_verified == true
      );
    }
    match /branding/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'nirab2ai@gmail.com' && request.auth.token.email_verified == true
      );
    }
    match /banners/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'nirab2ai@gmail.com' && request.auth.token.email_verified == true
      );
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'nirab2ai@gmail.com';
    }
  }
}
